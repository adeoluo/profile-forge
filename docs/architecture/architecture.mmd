flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["CLI and config"]
        direction TB
        User(["CLI user<br/>generate, check, init"]):::edge
        Cli["cli.Run<br/>commands, exit codes"]:::core
        Dashes["Dash scan<br/>U+2014, U+2013"]:::control
        Config["config.Load<br/>strict YAML, defaults"]:::control
        User --> Cli --> Dashes --> Config
    end

    subgraph Core["Fetch and render"]
        direction TB
        Token(["Token source<br/>env or gh auth token"]):::edge
        Api(["GitHub REST API"]):::edge
        Client["github.Client<br/>pagination, 8 workers"]:::core
        Build["render.Build<br/>view model, languages"]:::core
        Tmpl["Templates, charts<br/>sections, mermaid"]:::core
        Token ~~~ Api --> Client --> Build --> Tmpl
    end

    subgraph State["Data and state"]
        direction TB
        Yaml[("profile.yaml")]:::data
        Cache[("Disk cache<br/>SHA-256 keys, TTL")]:::data
        Yaml ~~~ Cache
    end

    subgraph Obs["Validation and outputs"]
        direction TB
        Validate["validate.Output<br/>dashes, mermaid"]:::control
        Readme["README.md<br/>written or compared"]:::obs
        Json["portfolio.json<br/>optional"]:::obs
        Links["CheckLinks<br/>optional image check"]:::control
        Coverage["Coverage warnings<br/>uncategorized repos"]:::obs
        Validate --> Readme ~~~ Json ~~~ Links ~~~ Coverage
    end

    Interfaces -->|config| Core
    Core -.->|reads, caches| State
    State ~~~ Obs
    Core -->|Markdown, View| Obs
